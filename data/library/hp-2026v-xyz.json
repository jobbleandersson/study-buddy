    { "id": "q-hp-2026v-xyz-01", "kind": "mc", "variant": "xyz", "topic": "algebra",
      "prompt": "Om $3x - 7 = 2x + 5$, vad är $x$?",
      "choices": ["$-2$", "$2$", "$6$", "$12$", "$-12$"],
      "answer": 3,
      "explanation": "$3x - 2x = 5 + 7$ ger $x = 12$.",
      "steps": ["Samla $x$-termerna i ena ledet: $3x - 2x = 5 + 7$.", "$x = 12$."] },
    { "id": "q-hp-2026v-xyz-02", "kind": "mc", "variant": "xyz", "topic": "andelar",
      "prompt": "En vara kostar 240 kr efter en prishöjning på 20 %. Vad kostade den innan höjningen?",
      "choices": ["192 kr", "200 kr", "216 kr", "220 kr", "288 kr"],
      "answer": 1,
      "explanation": "Nypris $= 1{,}20 \\cdot$ gammalt pris, så gammalt pris $= 240 / 1{,}20 = 200$.",
      "steps": ["$240 = 1{,}20 \\cdot p$.", "$p = 240 / 1{,}20 = 200$ kr."] },
    { "id": "q-hp-2026v-xyz-03", "kind": "mc", "variant": "xyz", "topic": "aritmetik",
      "prompt": "Vad är $\\dfrac{2}{3} + \\dfrac{1}{4}$?",
