  "questions": [
    { "id": "q-ordbank-01", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**nonchalant**\n\nNärmast i betydelse:", "choices": ["likgiltig", "artig", "nervös", "noggrann", "hemlighetsfull"], "answer": 0, "explanation": "Nonchalant = likgiltig, ointresserad, utan att bry sig." },
    { "id": "q-ordbank-02", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**pregnant**\n\nNärmast i betydelse:", "choices": ["långrandig", "träffande", "tveksam", "överdriven", "tillfällig"], "answer": 1, "explanation": "Pregnant (om formulering) = kärnfull, träffande, koncis." },
    { "id": "q-ordbank-03", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**obsolet**\n\nNärmast i betydelse:", "choices": ["hemlig", "föråldrad", "onödig", "olaglig", "oklar"], "answer": 1, "explanation": "Obsolet = föråldrad, ur bruk." },
    { "id": "q-ordbank-04", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**stringent**\n\nNärmast i betydelse:", "choices": ["sträng mot andra", "logiskt sammanhållen", "kortfattad", "hård i tonen", "krävande"], "answer": 1, "explanation": "Stringent = logiskt sammanhållen, konsekvent, utan glapp i resonemanget." },
    { "id": "q-ordbank-05", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**ambivalent**\n\nNärmast i betydelse:", "choices": ["kluven", "ärelysten", "obeslutsam av lättja", "likgiltig", "överdrivet försiktig"], "answer": 0, "explanation": "Ambivalent = kluven, med motstridiga känslor inför något." },
    { "id": "q-ordbank-06", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**tendentiös**\n\nNärmast i betydelse:", "choices": ["planlös", "vinklad", "omständlig", "modern", "överambitiös"], "answer": 1, "explanation": "Tendentiös = partisk, vinklad, som driver en tes." },
    { "id": "q-ordbank-07", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**frekvent**\n\nNärmast i betydelse:", "choices": ["ovanlig", "vanligt förekommande", "hastig", "regelbunden", "kraftig"], "answer": 1, "explanation": "Frekvent = som förekommer ofta." },
    { "id": "q-ordbank-08", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**restriktiv**\n\nNärmast i betydelse:", "choices": ["återhållsam", "sträng i uppfostran", "motvillig", "sparsam med pengar", "avvisande"], "answer": 0, "explanation": "Restriktiv = återhållsam, som begränsar." },
    { "id": "q-ordbank-09", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**divergera**\n\nNärmast i betydelse:", "choices": ["närma sig", "gå isär", "tveka", "avvika från regeln", "upprepa"], "answer": 1, "explanation": "Divergera = gå isär, avvika från varandra (motsats: konvergera)." },
    { "id": "q-ordbank-10", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**implicit**\n\nNärmast i betydelse:", "choices": ["uttalad", "underförstådd", "ofrivillig", "invecklad", "ovillkorlig"], "answer": 1, "explanation": "Implicit = underförstådd, inte uttalad rakt ut (motsats: explicit)." },
    { "id": "q-ordbank-11", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**succesiv**\n\nNärmast i betydelse:", "choices": ["framgångsrik", "gradvis", "omedelbar", "efterföljande", "upprepad"], "answer": 1, "explanation": "Succesiv (successiv) = som sker steg för steg, gradvis." },
    { "id": "q-ordbank-12", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**kategorisk**\n\nNärmast i betydelse:", "choices": ["tveksam", "ovillkorlig", "ordnad i grupper", "artig men bestämd", "logisk"], "answer": 1, "explanation": "Kategorisk = ovillkorlig, absolut, utan förbehåll ('ett kategoriskt nej')." },
    { "id": "q-ordbank-13", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**paradoxal**\n\nNärmast i betydelse:", "choices": ["skenbart motsägelsefull", "sällsynt", "omöjlig", "typisk", "svårbegriplig"], "answer": 0, "explanation": "Paradoxal = skenbart motsägelsefull men ändå möjligen sann." },
    { "id": "q-ordbank-14", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**rigorös**\n\nNärmast i betydelse:", "choices": ["sträng och noggrann", "styv i lederna", "orubblig i åsikter", "formell", "krävande mot sig själv"], "answer": 0, "explanation": "Rigorös = sträng, ytterst noggrann (t.ex. en rigorös granskning)." },
    { "id": "q-ordbank-15", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**pertinens**\n\nNärmast i betydelse:", "choices": ["fräckhet", "relevans", "envishet", "noggrannhet", "tydlighet"], "answer": 1, "explanation": "Pertinens = relevans, det att något är sakligt tillämpligt." },
    { "id": "q-ordbank-16", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**dubiös**\n\nNärmast i betydelse:", "choices": ["dyster", "tvivelaktig", "dubbelbottnad", "obeslutsam", "svårfångad"], "answer": 1, "explanation": "Dubiös = tvivelaktig, som inger misstanke." },
    { "id": "q-ordbank-17", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**kongruens**\n\nNärmast i betydelse:", "choices": ["överensstämmelse", "samling", "sammanträffande", "blandning", "förbindelse"], "answer": 0, "explanation": "Kongruens = överensstämmelse, att delar passar ihop." },
    { "id": "q-ordbank-18", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**perifer**\n\nNärmast i betydelse:", "choices": ["central", "i utkanten", "rörlig", "obetydlig av lättja", "tillfällig"], "answer": 1, "explanation": "Perifer = som ligger i utkanten, av mindre vikt (motsats: central)." },
    { "id": "q-ordbank-19", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**konsistent**\n\nNärmast i betydelse:", "choices": ["fast i konsistensen", "motsägelsefri", "ihållande", "tät", "pålitlig"], "answer": 1, "explanation": "Konsistent (om resonemang) = motsägelsefri, sammanhängande." },
    { "id": "q-ordbank-20", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**ekvivalent**\n\nNärmast i betydelse:", "choices": ["tvetydig", "likvärdig", "tveksam", "utbytbar mot pengar", "jämnstark"], "answer": 1, "explanation": "Ekvivalent = likvärdig, med samma värde eller innebörd." },
    { "id": "q-ordbank-21", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**subtil**\n\nNärmast i betydelse:", "choices": ["underdånig", "hårfin", "listig", "svag", "underförstådd"], "answer": 1, "explanation": "Subtil = hårfin, svår att uppfatta, med små nyanser." },
    { "id": "q-ordbank-22", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**explicit**\n\nNärmast i betydelse:", "choices": ["uttrycklig", "utförlig", "tydlig av misstag", "överdriven", "onödig"], "answer": 0, "explanation": "Explicit = uttrycklig, sagt rakt ut (motsats: implicit)." },
    { "id": "q-ordbank-23", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**potentiell**\n\nNärmast i betydelse:", "choices": ["kraftfull", "möjlig", "framtida", "sannolik", "dold"], "answer": 1, "explanation": "Potentiell = möjlig, som skulle kunna bli av." },
    { "id": "q-ordbank-24", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**diffus**\n\nNärmast i betydelse:", "choices": ["motsägelsefull", "oskarp", "svag", "spridd i tiden", "överdriven"], "answer": 1, "explanation": "Diffus = oskarp, utspridd, svår att avgränsa." },
    { "id": "q-ordbank-25", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**adekvat**\n\nNärmast i betydelse:", "choices": ["tillräcklig", "lämplig", "godkänd", "exakt", "rimlig"], "answer": 1, "explanation": "Adekvat = lämplig, som passar för ändamålet." },
    { "id": "q-ordbank-26", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**intrikat**\n\nNärmast i betydelse:", "choices": ["invecklad", "hemlighetsfull", "listig", "ovanlig", "ömtålig"], "answer": 0, "explanation": "Intrikat = invecklad, klurig, svår att reda ut." },
    { "id": "q-ordbank-27", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**kontrovers**\n\nNärmast i betydelse:", "choices": ["missförstånd", "tvist", "motsägelse", "jämförelse", "avtal"], "answer": 1, "explanation": "Kontrovers = tvist, meningsmotsättning i en fråga." },
    { "id": "q-ordbank-28", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**generisk**\n\nNärmast i betydelse:", "choices": ["generös", "allmän", "ursprunglig", "billig", "typisk för en art"], "answer": 1, "explanation": "Generisk = allmän, icke-specifik, som gäller en hel kategori." },
    { "id": "q-ordbank-29", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**flagrant**\n\nNärmast i betydelse:", "choices": ["uppenbar", "flyktig", "tillfällig", "pinsam", "avsiktlig"], "answer": 0, "explanation": "Flagrant = uppenbar, skriande (t.ex. ett flagrant brott mot reglerna)." },
    { "id": "q-ordbank-30", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**reticent**\n\nNärmast i betydelse:", "choices": ["förtegen", "tveksam", "eftertänksam", "avvaktande", "blygsam"], "answer": 0, "explanation": "Reticent = förtegen, ovillig att berätta, fåordig." },
    { "id": "q-ordbank-31", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**konjektur**\n\nNärmast i betydelse:", "choices": ["slutsats", "gissning", "sammanträffande", "villkor", "förhållande"], "answer": 1, "explanation": "Konjektur = en kvalificerad gissning, en förmodan." },
    { "id": "q-ordbank-32", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**redundant**\n\nNärmast i betydelse:", "choices": ["nödvändig", "överflödig", "återkommande", "onödigt lång", "reserverad"], "answer": 1, "explanation": "Redundant = överflödig, som inte tillför något nytt." },
    { "id": "q-ordbank-33", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**disparat**\n\nNärmast i betydelse:", "choices": ["desperat", "olikartad", "utspridd", "obetydlig", "motsägelsefull"], "answer": 1, "explanation": "Disparat = olikartad, osammanhängande, av skilda slag." },
    { "id": "q-ordbank-34", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**empirisk**\n\nNärmast i betydelse:", "choices": ["teoretisk", "erfarenhetsbaserad", "praktisk av naturen", "systematisk", "objektiv"], "answer": 1, "explanation": "Empirisk = grundad på observation och erfarenhet snarare än teori." },
    { "id": "q-ordbank-35", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**arbiträr**\n\nNärmast i betydelse:", "choices": ["godtycklig", "rättvis", "opartisk", "tvingande", "medlande"], "answer": 0, "explanation": "Arbiträr = godtycklig, utan sakligt skäl." },
    { "id": "q-ordbank-36", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**sporadisk**\n\nNärmast i betydelse:", "choices": ["oregelbunden", "sällsynt", "hastig", "kortvarig", "slumpartad men tät"], "answer": 0, "explanation": "Sporadisk = som förekommer då och då, oregelbundet och spritt." },
    { "id": "q-ordbank-37", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**nyansera**\n\nNärmast i betydelse:", "choices": ["förenkla", "göra mer sammansatt", "överdriva", "förtydliga", "ifrågasätta"], "answer": 1, "explanation": "Nyansera = ge en mer sammansatt, mindre tvärsäker bild av något." },
    { "id": "q-ordbank-38", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**konvergera**\n\nNärmast i betydelse:", "choices": ["mötas", "gå isär", "sammanfalla i tiden", "förenas formellt", "överlappa"], "answer": 0, "explanation": "Konvergera = närma sig varandra, sträva mot samma punkt (motsats: divergera)." },
    { "id": "q-ordbank-39", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**latent**\n\nNärmast i betydelse:", "choices": ["försenad", "dold men möjlig att väckas", "svag", "senkommen", "overksam av lättja"], "answer": 1, "explanation": "Latent = dold, vilande, men beredd att träda fram (en latent konflikt)." },
    { "id": "q-ordbank-40", "kind": "mc", "variant": "ord", "topic": "ordförråd", "prompt": "**prekär**\n\nNärmast i betydelse:", "choices": ["besvärlig och osäker", "brådskande", "pinsam", "farlig", "tillfällig"], "answer": 0, "explanation": "Prekär = svår, ömtålig, osäker (en prekär situation)." }
