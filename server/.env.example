ANTHROPIC_API_KEY=sk-ant-...
PORT=8787
COOKIE_SECURE=false
# ALLOWED_ORIGIN=https://example.com   # only needed if the frontend is hosted separately from this server

# --- /api/messages proxy: auth, metering, limits ---
# Require a signed-in session on the Claude proxy. Default on. Set to false
# ONLY for a trusted single-user / local run — with it off there is no user to
# attribute spend to, so metering is skipped and the key is spendable by
# anyone who can reach the server.
MESSAGES_REQUIRE_AUTH=true
# Per-user monthly token ceiling (input + output). Over it, /api/messages
# returns 402 until the UTC month rolls over. Tune against a real cost model.
AI_MONTHLY_TOKEN_BUDGET=2000000
# Hard cap on output tokens per request, whatever the client asks for.
AI_MAX_OUTPUT_TOKENS=16000
# Per-user request rate limit (requests per minute).
AI_RATE_PER_MIN=20
# Kill switch: set to true to make /api/messages return 503 without a redeploy.
# PROXY_DISABLED=true
