ANTHROPIC_API_KEY=sk-ant-...
PORT=8787
COOKIE_SECURE=false
# ALLOWED_ORIGIN=https://example.com   # only needed if the frontend is hosted separately from this server

# Where the SQLite database file is written. Unset = beside server/ (right for
# local dev). On a host, point this at a file on a mounted persistent disk
# (e.g. /data/studybuddy.sqlite3) or the data is lost on every deploy.
# DB_PATH=/data/studybuddy.sqlite3

# Optional: set a shared password to gate the whole site (HTTP basic auth,
# /api/* stays open) — handy for private staging. Unset = site is open.
# SITE_PASSWORD=change-me

# --- /api/messages proxy: auth, metering, limits ---
# Require a signed-in session on the Claude proxy. Default on. Set to false
# ONLY for a trusted single-user / local run — with it off there is no user to
# attribute spend to, so metering is skipped and the key is spendable by
# anyone who can reach the server.
MESSAGES_REQUIRE_AUTH=true
# Per-user monthly token ceiling (input + output). Over it, /api/messages
# returns 402 until the UTC month rolls over. 200,000 is a light student's month
# (a few AI-made sets plus some tutor chat). Tokens are a blunt meter — Sonnet
# output costs ten times Haiku input — so the daily dollar cap below is the real limit.
AI_MONTHLY_TOKEN_BUDGET=200000
# Accounts (by email, comma-separated) that skip that per-account ceiling: the owner and testers.
# Empty = nobody is exempt. Their requests are still metered, and the daily dollar cap below
# still applies to them, so this cannot run up an unbounded bill.
# AI_BUDGET_EXEMPT_EMAILS=you@example.com
# Daily dollar cap for the WHOLE server, in USD, estimated from token counts and
# the list prices in src/usage.js. Once it's reached /api/messages answers 503
# (code "daily_cap") for everyone until 00:00 UTC. A "[spend-alert]" line is logged
# at 50%, 80% and 100% of it — read them with `fly logs`. 0 = no cap.
AI_DAILY_SPEND_CAP_USD=5
# Hard cap on output tokens per request, whatever the client asks for.
AI_MAX_OUTPUT_TOKENS=16000
# Per-user request rate limit (requests per minute).
AI_RATE_PER_MIN=20

# --- signup / login / code-guessing limits ---
# Per IP unless noted (an IPv6 address counts as its /64). Kept in memory, so a
# restart resets them. A school signing up a few classes from one Wi-Fi is the
# case to keep in mind: raise these if a real class gets blocked. 0 = off.
# On Fly the address comes from the Fly-Client-IP header (see middleware/attemptLimit.js).
# SIGNUPS_PER_HOUR_PER_IP=60
# SIGNUPS_PER_DAY_PER_IP=200
# LOGIN_FAILS_PER_15MIN_PER_ACCOUNT=10   # wrong passwords for one account from one IP
# LOGIN_FAILS_PER_15MIN_PER_IP=300       # wrong passwords from one IP across all accounts
# CODE_FAILS_PER_10MIN_PER_USER=10       # class / friend / parent codes; only failed guesses count
# CODE_FAILS_PER_10MIN_PER_IP=100
# Kill switch: set to true to make /api/messages return 503 without a redeploy.
# PROXY_DISABLED=true

# Optional: "Sign in with Google". Unset = the sign-in screen shows no Google
# button. The client id is public (not a secret); see HOSTING-FLYIO.md.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_SIGNIN_FAILS_PER_MIN_PER_IP=30   # only rejected sign-ins count

# Optional https link offered as a "See Premium" button in the "you've used
# this month's AI allowance" prompt. Unset = the prompt only explains the
# limit. No plan exists to sell yet, so point this at the built-in waitlist
# page ("#/premium", collects an email into the premium_waitlist table) —
# swap it for a real Stripe Payment Link once there's something to sell, but
# paying still won't raise anyone's allowance by itself: that needs plan
# tracking on the server too.
# PREMIUM_URL=https://your-deployed-domain/#/premium

# Optional: email verification and "forgot password" links, sent via Resend
# (https://resend.com — free tier, one API key, no SMTP setup). Unset = the
# sign-up/sign-in screen shows no verify or reset UI at all, and every
# account is treated as verified — exactly like today. Get a key at
# resend.com/api-keys; EMAIL_FROM must be a domain you've verified there, or
# Resend's own onboarding.resend.dev sender for testing (a handful of emails
# a day, to your own inbox only).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Studify <onboarding@resend.dev>
# The base URL this server is actually reached at — verify/reset emails link
# to PUBLIC_URL/#/verify?token=... and need the real one, not a guess.
# PUBLIC_URL=https://your-deployed-domain
# RESEND_VERIFY_PER_HOUR_PER_USER=5
# FORGOT_PW_PER_HOUR_PER_IP=30
# VERIFY_EMAIL_PER_HOUR_PER_IP=60
# RESET_PW_PER_HOUR_PER_IP=30

# Optional: shared secret to read GET /api/analytics/summary — aggregated,
# anonymous pageview counts (by day, UTM source/campaign, path, referrer) fed
# by every app load. Unset = the endpoint is disabled (404). Pick any random
# string, then read it with the key as a header (not a "?key=" query string —
# that would end up in request logs and browser history), e.g.:
#   curl -H "x-analytics-key: that-string" https://your-deployed-domain/api/analytics/summary
# ANALYTICS_KEY=change-me
# PAGEVIEW_PER_HOUR_PER_IP=300
